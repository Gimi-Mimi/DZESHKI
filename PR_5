import math

def calculate_distance(x1, y1, x2, y2):
    """
    Рассчитывает расстояние между двумя точками на плоскости.
    Принимает: координаты x1, y1 первой точки и x2, y2 второй точки.
    Возвращает: float - длину отрезка.
    """
    return math.sqrt((x2 - x1) ** 2 + (y2 - y1) ** 2)

def calculate_triangle_area(a, b, c):
    """
    Рассчитывает площадь треугольника по формуле Герона.
    Принимает: длины трех сторон a, b, c.
    Возвращает: float - площадь треугольника.
    """
    p = (a + b + c) / 2
    area = math.sqrt(p * (p - a) * (p - b) * (p - c))
    return area

# Основная программа
x_a, y_a = map(float, input("Координаты точки A: ").split())
x_b, y_b = map(float, input("Координаты точки B: ").split())
x_c, y_c = map(float, input("Координаты точки C: ").split())

# 1. Находим длины сторон, вызывая первую функцию 3 раза
side_ab = calculate_distance(x_a, y_a, x_b, y_b)
side_bc = calculate_distance(x_b, y_b, x_c, y_c)
side_ca = calculate_distance(x_c, y_c, x_a, y_a)

# 2. Передаем длины во вторую функцию для расчета площади
triangle_area = calculate_triangle_area(side_ab, side_bc, side_ca)

# 3. Выводим результат
print(f"\nПлощадь треугольника: {triangle_area:.2f}")




