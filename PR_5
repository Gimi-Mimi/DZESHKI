USD_TO_RUB = 95.50

def convert(amount_usd):
    """
       Конвертирует сумму из долларов в рубли по заданному курсу.
       Принимает: amount_usd (float) - сумма в долларах.
       Возвращает: float - сумма в рублях.
       """
    rub = USD_TO_RUB * amount_usd
    return rub

